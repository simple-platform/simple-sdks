{
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.useFlatConfig": true,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off"
    },
    {
      "rule": "format/*",
      "severity": "off"
    },
    {
      "rule": "*-indent",
      "severity": "off"
    },
    {
      "rule": "*-spacing",
      "severity": "off"
    },
    {
      "rule": "*-spaces",
      "severity": "off"
    },
    {
      "rule": "*-order",
      "severity": "off"
    },
    {
      "rule": "*-dangle",
      "severity": "off"
    },
    {
      "rule": "*-newline",
      "severity": "off"
    },
    {
      "rule": "*quotes",
      "severity": "off"
    },
    {
      "rule": "*semi",
      "severity": "off"
    }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "yaml",
    "toml",
    "xml",
    "gql",
    "graphql",
    "astro"
  ],
  "rust-analyzer.linkedProjects": [
    "sdks/rust/Cargo.toml"
  ],
  "cSpell.words": [
    "Asyncify",
    "authorises",
    "binaryen",
    "clippy",
    "codegen",
    "deserialise",
    "deserialised",
    "destructures",
    "DEVBOX",
    "esac",
    "esbuild",
    "feff",
    "financials",
    "initialisation",
    "Javy",
    "jetify",
    "licence",
    "multibyte",
    "multivalue",
    "myapp",
    "mycompany",
    "nontrapping",
    "npmjs",
    "optimise",
    "organised",
    "paulhatch",
    "pipefail",
    "Requiredness",
    "retryability",
    "rustc",
    "rustup",
    "serde",
    "serialise",
    "serialised",
    "serialises",
    "serialising",
    "simpleplatform",
    "softprops",
    "Summarise",
    "travelling",
    "TRYBUILD",
    "unencodable",
    "unreportable",
    "unrepresentable",
    "unwritable",
    "unwriteable",
    "wasip"
  ],
  "rust-analyzer.server.extraEnv": {
    "RUSTUP_HOME": "${workspaceFolder}/.rustup",
    "RUSTC": "${workspaceFolder}/.devbox/nix/profile/default/bin/rustc"
  },
  "rust-analyzer.cargo.extraEnv": {
    "RUSTUP_HOME": "${workspaceFolder}/.rustup",
    "RUSTC": "${workspaceFolder}/.devbox/nix/profile/default/bin/rustc"
  },
  "rust-analyzer.check.extraEnv": {
    "RUSTUP_HOME": "${workspaceFolder}/.rustup",
    "RUSTC": "${workspaceFolder}/.devbox/nix/profile/default/bin/rustc"
  }
}
